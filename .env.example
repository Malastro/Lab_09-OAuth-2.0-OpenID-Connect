# Configuración de Microsoft Entra ID (OAuth 2.0 / OIDC)
CLIENT_ID=your-application-client-id
TENANT_ID=your-directory-tenant-id
CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:5000/getAToken
POST_LOGOUT_REDIRECT_URI=http://localhost:5000/

# Seguridad de sesiones en Flask
# Generar una clave criptográficamente segura (mínimo 32 caracteres):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=GENERA_TU_PROPIA_CLAVE_ALEATORIA_CON_EL_COMANDO_SUPERIOR

# Cookies seguras: 'false' para desarrollo local (HTTP), 'true' para producción (HTTPS)
SESSION_COOKIE_SECURE=false

# Duración de la sesión en minutos (por defecto: 60)
PERMANENT_SESSION_LIFETIME_MINUTES=60
